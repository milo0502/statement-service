                { "key": "file", "type": "file", "src": "postman/sample-statement.pdf" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/statements"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('unsafe metadata is 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
