{
  "info": {
    "name": "Statement Service Production Readiness Tests",
    "description": "End-to-end Postman scenarios for statement-service. Use local/dev token requests only with local/dev profiles. For docker, staging, or production-like profiles, paste real JWTs into the collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "customerId", "value": "cust-001" },
    { "key": "otherCustomerId", "value": "cust-002" },
    { "key": "accountId", "value": "acc-123" },
    { "key": "adminToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "otherCustomerToken", "value": "" },
    { "key": "statementId", "value": "" },
    { "key": "duplicateFirstStatementId", "value": "" },
    { "key": "duplicateSecondStatementId", "value": "" },
    { "key": "revokedStatementId", "value": "" },
    { "key": "rateLimitStatementId", "value": "" },
    { "key": "downloadUrl", "value": "" },
    { "key": "rateLimitAttempt", "value": "1" },
    { "key": "missingStatementId", "value": "00000000-0000-0000-0000-000000000001" }
  ],
  "item": [
    {
      "name": "00 Operational Endpoints",
      "item": [
        {
          "name": "Health Is Public",
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('health is 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Readiness Is Public",
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health/readiness" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('readiness is 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Liveness Is Public",
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health/liveness" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('liveness is 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Prometheus Is Not Public",
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/prometheus" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('prometheus is protected', function () { pm.expect([401, 403, 404]).to.include(pm.response.code); });"] } }]
        },
        {
          "name": "Metrics Are Not Public",
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/metrics" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('metrics are protected', function () { pm.expect([401, 403, 404]).to.include(pm.response.code); });"] } }]
        },
        {
          "name": "OpenAPI Docs Are Not Public",
          "request": { "method": "GET", "url": "{{baseUrl}}/v3/api-docs" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('api docs are protected', function () { pm.expect([401, 403, 404]).to.include(pm.response.code); });"] } }]
        },
        {
          "name": "Swagger UI Is Not Public",
          "request": { "method": "GET", "url": "{{baseUrl}}/swagger-ui/index.html" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('swagger is protected', function () { pm.expect([401, 403, 404]).to.include(pm.response.code); });"] } }]
        }
      ]
    },
    {
      "name": "01 Local Dev Tokens",
      "description": "Run these only when the app is started with SPRING_PROFILES_ACTIVE=local or dev. In docker/staging/production-like profiles, paste real JWTs into collection variables instead.",
      "item": [
        {
          "name": "Create Admin Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"customerId\":\"admin\",\"scope\":\"admin\"}" },
            "url": "{{baseUrl}}/api/v1/dev/token"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('admin token created', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.collectionVariables.set('adminToken', pm.response.json().token); }"
          ] } }]
        },
        {
          "name": "Create Customer Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"customerId\":\"{{customerId}}\",\"scope\":\"customer\"}" },
            "url": "{{baseUrl}}/api/v1/dev/token"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('customer token created', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.collectionVariables.set('customerToken', pm.response.json().token); }"
          ] } }]
        },
        {
          "name": "Create Other Customer Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"customerId\":\"{{otherCustomerId}}\",\"scope\":\"customer\"}" },
            "url": "{{baseUrl}}/api/v1/dev/token"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('other customer token created', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.collectionVariables.set('otherCustomerToken', pm.response.json().token); }"
          ] } }]
        }
      ]
    },
    {
      "name": "02 Statement Happy Path",
      "item": [
        {
          "name": "Upload Statement As Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "customerId", "value": "{{customerId}}", "type": "text" },
                { "key": "accountId", "value": "{{accountId}}", "type": "text" },
                { "key": "periodStart", "value": "2026-01-01", "type": "text" },
                { "key": "periodEnd", "value": "2026-01-31", "type": "text" },
                { "key": "file", "type": "file", "src": "postman/sample-statement.pdf" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/statements"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('upload returns 201', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.collectionVariables.set('statementId', pm.response.json().id); }"
          ] } }]
        },
        {
          "name": "List Statements As Customer",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements?page=0&size=10&sort=uploadedAt,desc"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('customer list is 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "List Statements As Admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements?page=0&size=100"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin list is 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Get Statement Metadata As Owner",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements/{{statementId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('metadata is 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Generate Download Link As Owner",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"ttlSeconds\":300}" },
            "url": "{{baseUrl}}/api/v1/statements/{{statementId}}/download-link"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('download link is 200', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.collectionVariables.set('downloadUrl', pm.response.json().url); }"
          ] } }]
        },
        {
          "name": "Redirect Download As Owner",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements/{{statementId}}/download"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('redirect is 302', function () { pm.expect([302, 301, 307]).to.include(pm.response.code); });"] } }]
        }
      ]
    },
    {
      "name": "03 Idempotency And Admin Semantics",
      "item": [
        {
          "name": "Duplicate Upload First",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "customerId", "value": "{{customerId}}", "type": "text" },
                { "key": "accountId", "value": "acc-duplicate", "type": "text" },
                { "key": "periodStart", "value": "2026-02-01", "type": "text" },
                { "key": "periodEnd", "value": "2026-02-28", "type": "text" },
                { "key": "file", "type": "file", "src": "postman/sample-statement.pdf" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/statements"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('first duplicate upload returns 201', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.collectionVariables.set('duplicateFirstStatementId', pm.response.json().id); }"
          ] } }]
        },
        {
          "name": "Duplicate Upload Second Returns Same Statement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "customerId", "value": "{{customerId}}", "type": "text" },
                { "key": "accountId", "value": "acc-duplicate", "type": "text" },
                { "key": "periodStart", "value": "2026-02-01", "type": "text" },
                { "key": "periodEnd", "value": "2026-02-28", "type": "text" },
                { "key": "file", "type": "file", "src": "postman/sample-statement.pdf" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/statements"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('second duplicate upload returns 201', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) {",
            "  pm.collectionVariables.set('duplicateSecondStatementId', pm.response.json().id);",
            "  pm.test('duplicate statement id matches first', function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('duplicateFirstStatementId')); });",
            "}"
          ] } }]
        },
        {
          "name": "Admin Reads Customer Statement",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements/{{statementId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin metadata is 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Admin Generates Customer Download Link",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"ttlSeconds\":300}" },
            "url": "{{baseUrl}}/api/v1/statements/{{statementId}}/download-link"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin download link is 200', function () { pm.response.to.have.status(200); });"] } }]
        }
      ]
    },
    {
      "name": "04 Revoke And Audit",
      "item": [
        {
          "name": "Upload Statement To Revoke",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "customerId", "value": "{{customerId}}", "type": "text" },
                { "key": "accountId", "value": "acc-revoke", "type": "text" },
                { "key": "periodStart", "value": "2026-03-01", "type": "text" },
                { "key": "periodEnd", "value": "2026-03-31", "type": "text" },
                { "key": "file", "type": "file", "src": "postman/sample-statement.pdf" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/statements"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('revoke setup upload returns 201', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.collectionVariables.set('revokedStatementId', pm.response.json().id); }"
          ] } }]
        },
        {
          "name": "Revoke Statement As Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements/{{revokedStatementId}}/revoke"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('revoke returns 204', function () { pm.response.to.have.status(204); });"] } }]
        },
        {
          "name": "Revoked Download Link Fails",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"ttlSeconds\":300}" },
            "url": "{{baseUrl}}/api/v1/statements/{{revokedStatementId}}/download-link"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('revoked download link is 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Revoked Redirect Download Fails",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements/{{revokedStatementId}}/download"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('revoked redirect is 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Audit Events As Admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/audit-events?page=0&size=50"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('audit list is 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Audit Filter By Customer And Action",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/audit-events?customerId={{customerId}}&action=UPLOAD&page=0&size=20&sort=createdAt,desc"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('filtered audit list is 200', function () { pm.response.to.have.status(200); });"] } }]
        }
      ]
    },
    {
      "name": "05 Authorization Negative Scenarios",
      "item": [
        {
          "name": "Missing Token Is Unauthorized",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/statements" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('missing token is 401', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "Malformed Token Is Unauthorized",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not-a-jwt" }],
            "url": "{{baseUrl}}/api/v1/statements"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('malformed token is 401', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "Customer Cannot Upload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "customerId", "value": "{{customerId}}", "type": "text" },
                { "key": "accountId", "value": "acc-forbidden", "type": "text" },
                { "key": "periodStart", "value": "2026-04-01", "type": "text" },
                { "key": "periodEnd", "value": "2026-04-30", "type": "text" },
                { "key": "file", "type": "file", "src": "postman/sample-statement.pdf" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/statements"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('customer upload is 403', function () { pm.response.to.have.status(403); });"] } }]
        },
        {
          "name": "Other Customer Cannot Read Metadata",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherCustomerToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements/{{statementId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('cross customer metadata is 404', function () { pm.response.to.have.status(404); });"] } }]
        },
        {
          "name": "Other Customer Cannot Generate Download Link",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{otherCustomerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"ttlSeconds\":300}" },
            "url": "{{baseUrl}}/api/v1/statements/{{statementId}}/download-link"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('cross customer download link is 404', function () { pm.response.to.have.status(404); });"] } }]
        },
        {
          "name": "Customer Cannot Read Audit Events",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/audit-events"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('customer audit is 403', function () { pm.response.to.have.status(403); });"] } }]
        },
        {
          "name": "Dev Token Endpoint Unavailable Outside Local",
          "description": "Run this only against docker/staging/production-like profiles. In local/dev it should return 200.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"customerId\":\"cust-dev\",\"scope\":\"customer\"}" },
            "url": "{{baseUrl}}/api/v1/dev/token"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('dev token unavailable in production-like profile', function () { pm.expect([401, 403, 404]).to.include(pm.response.code); });"] } }]
        }
      ]
    },
    {
      "name": "06 Validation Negative Scenarios",
      "item": [
        {
          "name": "Invalid Statement Page Size",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements?size=101"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('invalid size is 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Invalid Statement Negative Page",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements?page=-1"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('negative page is 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Unsupported Statement Sort",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/statements?sort=sha256"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('unsupported statement sort is 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Unsupported Audit Action",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/audit-events?action=DELETE"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('unsupported audit action is 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Invalid Audit Customer Filter",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/audit-events?customerId=../customer"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('invalid audit customer filter is 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Invalid Download Link TTL Too Low",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"ttlSeconds\":29}" },
            "url": "{{baseUrl}}/api/v1/statements/{{statementId}}/download-link"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ttl too low is 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Invalid Period Range Upload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "customerId", "value": "{{customerId}}", "type": "text" },
                { "key": "accountId", "value": "acc-invalid-period", "type": "text" },
                { "key": "periodStart", "value": "2026-05-31", "type": "text" },
                { "key": "periodEnd", "value": "2026-05-01", "type": "text" },
                { "key": "file", "type": "file", "src": "postman/sample-statement.pdf" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/statements"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('invalid period range is 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Unsafe Metadata Upload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "customerId", "value": "../customer", "type": "text" },
                { "key": "accountId", "value": "acc-invalid-metadata", "type": "text" },
                { "key": "periodStart", "value": "2026-06-01", "type": "text" },
