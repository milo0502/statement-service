    },
    {
      "name": "07 Rate Limiting",
      "description": "Default local/docker rate limit is usually 10 requests per 60 seconds. If your environment uses a different limit, repeat download-link attempts until 429.",
      "item": [
        {
          "name": "Upload Statement For Rate Limit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "customerId", "value": "{{customerId}}", "type": "text" },
                { "key": "accountId", "value": "acc-rate-limit", "type": "text" },
                { "key": "periodStart", "value": "2026-10-01", "type": "text" },
                { "key": "periodEnd", "value": "2026-10-31", "type": "text" },
                { "key": "file", "type": "file", "src": "postman/sample-statement.pdf" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/statements"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('rate limit setup upload returns 201', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.collectionVariables.set('rateLimitStatementId', pm.response.json().id); }"
          ] } }]
        },
        {
          "name": "Download Link Loop Until 429",
          "description": "In Collection Runner, this request loops up to 12 attempts or until a 429 is returned. Manually, send it repeatedly until 429.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"ttlSeconds\":300}" },
            "url": "{{baseUrl}}/api/v1/statements/{{rateLimitStatementId}}/download-link"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const attempt = parseInt(pm.collectionVariables.get('rateLimitAttempt') || '1', 10);",
            "pm.test('download-link returns ok or rate limited', function () { pm.expect([200, 429]).to.include(pm.response.code); });",
            "if (pm.response.code !== 429 && attempt < 12) {",
            "  pm.collectionVariables.set('rateLimitAttempt', String(attempt + 1));",
            "  postman.setNextRequest(pm.info.requestName);",
            "} else {",
            "  pm.test('rate limit reached by attempt 12', function () { pm.expect(pm.response.code).to.eql(429); });",
            "  pm.collectionVariables.set('rateLimitAttempt', '1');",
            "}"
          ] } }]
        },
        {
          "name": "Manual Extra Download Link Attempt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"ttlSeconds\":300}" },
            "url": "{{baseUrl}}/api/v1/statements/{{rateLimitStatementId}}/download-link"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('429 appears once quota is exhausted', function () { pm.expect([200, 429]).to.include(pm.response.code); });"] } }]
        }
      ]
    }
  ]
