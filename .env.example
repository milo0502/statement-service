SPRING_PROFILES_ACTIVE=docker

DB_URL=jdbc:postgresql://postgres:5432/statements
DB_USER=statements
DB_PASS=statements

S3_ENDPOINT=http://minio:9000
S3_EXTERNAL_ENDPOINT=http://localhost:9000
S3_REGION=af-south-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=statements
S3_CONNECTION_TIMEOUT_MS=2000
S3_SOCKET_TIMEOUT_MS=5000
S3_API_CALL_TIMEOUT_MS=10000
S3_API_CALL_ATTEMPT_TIMEOUT_MS=4000
S3_MAX_RETRIES=3

JWT_ISSUER=https://idp.example.com/
JWT_AUDIENCE=statement-service
JWT_JWK_SET_URI=https://idp.example.com/.well-known/jwks.json

RATE_LIMIT_DOWNLOAD_LINK_LIMIT=10
RATE_LIMIT_DOWNLOAD_LINK_WINDOW_SECONDS=60
RATE_LIMIT_DOWNLOAD_LINK_FAILURE_MODE=DENY

AUDIT_REQUIRED=true
AUDIT_MAX_ATTEMPTS=3
AUDIT_RETRY_DELAY_MILLIS=100

SHUTDOWN_PHASE_TIMEOUT=30s
SERVER_CONNECTION_TIMEOUT=20s
SERVER_KEEP_ALIVE_TIMEOUT=15s
SERVER_MAX_KEEP_ALIVE_REQUESTS=100
SERVER_MAX_HTTP_REQUEST_HEADER_SIZE=16KB
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25 -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
SPRING_SERVLET_MULTIPART_LOCATION=/tmp/statement-service-uploads

ORPHAN_CLEANUP_ENABLED=true
ORPHAN_CLEANUP_BATCH_SIZE=100
ORPHAN_CLEANUP_MIN_OBJECT_AGE_SECONDS=900
ORPHAN_CLEANUP_INITIAL_DELAY_MILLIS=60000
ORPHAN_CLEANUP_FIXED_DELAY_MILLIS=3600000

HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_CONNECTION_TIMEOUT_MS=30000
HIKARI_IDLE_TIMEOUT_MS=600000
HIKARI_MAX_LIFETIME_MS=1800000
HIKARI_LEAK_DETECTION_THRESHOLD_MS=60000
